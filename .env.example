# Aila Ecosystem environment template.
# Copy to .env.local for local development. Never commit secrets.
#
# Production and preview deployments must set these in the Vercel project
# (Production / Preview scopes). Do not copy production credentials into
# local files or git. Local development uses test/dev keys only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Clerk (required for sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/products/daily
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/products/daily

# Database (Prisma)
DATABASE_URL=

# AI (OpenRouter) — must be an OpenRouter key (sk-or-v1-...), not OpenAI/Anthropic
OPENROUTER_API_KEY=

# Paystack — Aila Pro subscriptions (NGN)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE_MONTHLY=
PAYSTACK_PLAN_CODE_YEARLY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROJECT_INQUIRY_EMAIL=

# Cron (Vercel Cron Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# Aila Ads does not connect to Meta, Google, TikTok, or LinkedIn in this release.
# Do not add ad-network tokens and expect live metrics — the product will not
# treat unused environment variables as a connected integration.

# Optional: reserved if/when @supabase/server is wired into a route
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
