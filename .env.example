# Aila Ecosystem environment template.
# Copy to .env.local for local development. Never commit secrets.
#
# Production and preview deployments must set these in the Vercel project
# (Production / Preview scopes). Do not copy production credentials into
# local files or git. Local development uses test/dev keys only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Clerk (required for sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Database (Prisma)
DATABASE_URL=

# AI (OpenRouter)
OPENROUTER_API_KEY=

# Stripe — commerce checkout and Aila Pro subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROJECT_INQUIRY_EMAIL=

# Cron (Vercel Cron Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# Optional: reserved if/when @supabase/server is wired into a route
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
