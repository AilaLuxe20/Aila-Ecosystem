@import "tw-animate-css";

/**
 * Aila design tokens.
 *
 * Registered with Tailwind v4 via `@theme`, which generates matching utilities
 * (`bg-surface-raised`, `shadow-elevation-3`, `ease-emphasized`, and so on).
 *
 * This file only ADDS tokens. It never overrides a Tailwind default, so
 * existing markup renders exactly as it did before the design system landed.
 */

@theme {
  /* ---------------------------------------------------------------------
   * Brand colour ramp
   * ------------------------------------------------------------------ */
  --color-brand-50: oklch(0.977 0.021 213.6);
  --color-brand-100: oklch(0.951 0.043 213.6);
  --color-brand-200: oklch(0.901 0.076 213.6);
  --color-brand-300: oklch(0.842 0.107 213.6);
  --color-brand-400: oklch(0.769 0.13 213.6);
  --color-brand-500: oklch(0.696 0.143 213.6);
  --color-brand-600: oklch(0.609 0.126 213.6);
  --color-brand-700: oklch(0.52 0.106 213.6);
  --color-brand-800: oklch(0.432 0.085 213.6);
  --color-brand-900: oklch(0.36 0.068 213.6);
  --color-brand-950: oklch(0.256 0.049 213.6);

  /* ---------------------------------------------------------------------
   * Semantic status colours
   * ------------------------------------------------------------------ */
  --color-success: oklch(0.723 0.183 149.6);
  --color-success-subtle: oklch(0.27 0.06 149.6);
  --color-warning: oklch(0.795 0.162 86.05);
  --color-warning-subtle: oklch(0.29 0.06 86.05);
  --color-danger: oklch(0.637 0.208 25.33);
  --color-danger-subtle: oklch(0.28 0.08 25.33);
  --color-info: oklch(0.696 0.143 213.6);
  --color-info-subtle: oklch(0.28 0.06 213.6);

  /* ---------------------------------------------------------------------
   * Surfaces. Each step reads as one layer closer to the viewer.
   * ------------------------------------------------------------------ */
  --color-canvas: oklch(0.145 0 0);
  --color-surface-sunken: oklch(0.16 0 0);
  --color-surface: oklch(0.19 0 0);
  --color-surface-raised: oklch(0.225 0 0);
  --color-surface-overlay: oklch(0.26 0 0);

  /* ---------------------------------------------------------------------
   * Hairlines
   * ------------------------------------------------------------------ */
  --color-hairline: oklch(1 0 0 / 8%);
  --color-hairline-strong: oklch(1 0 0 / 16%);

  /* ---------------------------------------------------------------------
   * Elevation. Layered shadows read as physical depth rather than a blur.
   * ------------------------------------------------------------------ */
  --shadow-elevation-1: 0 1px 2px oklch(0 0 0 / 24%);
  --shadow-elevation-2: 0 2px 4px oklch(0 0 0 / 20%), 0 1px 2px oklch(0 0 0 / 24%);
  --shadow-elevation-3: 0 4px 12px oklch(0 0 0 / 24%), 0 2px 4px oklch(0 0 0 / 20%);
  --shadow-elevation-4: 0 12px 28px oklch(0 0 0 / 28%), 0 4px 8px oklch(0 0 0 / 20%);
  --shadow-elevation-5: 0 24px 56px oklch(0 0 0 / 34%), 0 8px 16px oklch(0 0 0 / 22%);
  --shadow-glow-brand: 0 0 0 1px oklch(0.696 0.143 213.6 / 30%), 0 8px 32px oklch(0.696 0.143 213.6 / 18%);

  /* ---------------------------------------------------------------------
   * Radius scale
   * ------------------------------------------------------------------ */
  --radius-control: 0.5rem;
  --radius-panel: 0.875rem;
  --radius-modal: 1.125rem;

  /* ---------------------------------------------------------------------
   * Motion. Durations and easings are shared by CSS and Framer Motion so
   * animation feels identical regardless of which drives it.
   * ------------------------------------------------------------------ */
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --ease-emphasized: cubic-bezier(0.3, 0, 0, 1);
  --ease-decelerate: cubic-bezier(0, 0, 0, 1);
  --ease-accelerate: cubic-bezier(0.3, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  --duration-instant: 80ms;
  --duration-fast: 140ms;
  --duration-normal: 220ms;
  --duration-slow: 320ms;
  --duration-deliberate: 480ms;

  /* ---------------------------------------------------------------------
   * Typography
   * ------------------------------------------------------------------ */
  --text-2xs: 0.6875rem;
  --text-2xs--line-height: 1rem;
  --text-2xs--letter-spacing: 0.02em;

  /* ---------------------------------------------------------------------
   * Layout metrics consumed by the shell
   * ------------------------------------------------------------------ */
  --spacing-sidebar: 16rem;
  --spacing-sidebar-collapsed: 3.75rem;
  --spacing-topbar: 3.5rem;

  /* ---------------------------------------------------------------------
   * Keyframe-backed animation utilities
   * ------------------------------------------------------------------ */
  --animate-shimmer: shimmer 1.6s linear infinite;
  --animate-indeterminate: indeterminate 1.4s var(--ease-standard) infinite;
  --animate-spin-slow: spin 1.2s linear infinite;
}

@keyframes shimmer {
  from {
    background-position: -200% 0;
  }
  to {
    background-position: 200% 0;
  }
}

@keyframes indeterminate {
  0% {
    transform: translateX(-100%) scaleX(0.35);
  }
  50% {
    transform: translateX(0%) scaleX(0.55);
  }
  100% {
    transform: translateX(100%) scaleX(0.35);
  }
}

/**
 * Light-scheme overrides.
 *
 * Scoped to `.theme-light` rather than a media query so a single subtree can be
 * rendered light while the rest of the app stays dark.
 */
.theme-light {
  --color-canvas: oklch(0.995 0 0);
  --color-surface-sunken: oklch(0.972 0 0);
  --color-surface: oklch(1 0 0);
  --color-surface-raised: oklch(1 0 0);
  --color-surface-overlay: oklch(1 0 0);
  --color-hairline: oklch(0 0 0 / 10%);
  --color-hairline-strong: oklch(0 0 0 / 18%);
  --color-success-subtle: oklch(0.94 0.05 149.6);
  --color-warning-subtle: oklch(0.95 0.05 86.05);
  --color-danger-subtle: oklch(0.94 0.05 25.33);
  --color-info-subtle: oklch(0.94 0.04 213.6);

  --shadow-elevation-1: 0 1px 2px oklch(0 0 0 / 6%);
  --shadow-elevation-2: 0 2px 4px oklch(0 0 0 / 6%), 0 1px 2px oklch(0 0 0 / 4%);
  --shadow-elevation-3: 0 4px 12px oklch(0 0 0 / 8%), 0 2px 4px oklch(0 0 0 / 5%);
  --shadow-elevation-4: 0 12px 28px oklch(0 0 0 / 10%), 0 4px 8px oklch(0 0 0 / 6%);
  --shadow-elevation-5: 0 24px 56px oklch(0 0 0 / 12%), 0 8px 16px oklch(0 0 0 / 7%);
}

/**
 * Frosted-glass surface.
 *
 * `backdrop-filter` is applied only where the browser supports it; otherwise
 * the surface falls back to a solid colour so text contrast is preserved.
 */
@utility glass {
  background-color: color-mix(in oklab, var(--color-surface) 82%, transparent);
  border: 1px solid var(--color-hairline);
}

@supports (backdrop-filter: blur(1px)) {
  @utility glass {
    background-color: color-mix(in oklab, var(--color-surface) 55%, transparent);
    backdrop-filter: blur(20px) saturate(160%);
  }
}

/** Shimmering placeholder fill used by `Skeleton`. */
@utility skeleton-fill {
  background-image: linear-gradient(
    90deg,
    color-mix(in oklab, var(--color-surface-raised) 100%, transparent) 0%,
    color-mix(in oklab, var(--color-surface-overlay) 100%, transparent) 50%,
    color-mix(in oklab, var(--color-surface-raised) 100%, transparent) 100%
  );
  background-size: 200% 100%;
  animation: var(--animate-shimmer);
}

/** Consistent keyboard focus ring, offset so it never overlaps the control. */
@utility focus-ring {
  outline: 2px solid var(--color-brand-400);
  outline-offset: 2px;
}
