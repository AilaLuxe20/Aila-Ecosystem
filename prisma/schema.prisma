generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The 'url' property has been removed to comply with Prisma 7 configuration requirements
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  email                  String                   @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  stripeCustomerId       String?                  @unique
  accounts               Account[]
  sessions               Session[]
  conversations          Conversation[]
  legalDocuments         LegalDocument[]
  intelligenceDocuments  IntelligenceDocument[]
  projectInquiries       ProjectInquiry[]
  calendarEvents         CalendarEvent[]
  businessContacts       BusinessContact[]
  businessTasks          BusinessTask[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  commerceProducts       CommerceProduct[]
  commerceOrders         CommerceOrder[]
  adsCampaigns           AdsCampaign[]
  appListings            AppListing[]
  sites                  Site[]
  flows                  Flow[]
  billingSubscriptions   BillingSubscription[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  mode      String   @default("intelligence")
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]
  intelligenceDocuments  IntelligenceDocument[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model LegalDocument {
  id             String   @id @default(cuid())
  userId         String
  fileName       String
  fileSize       Int
  mimeType       String
  fileType       String
  content        String   @db.Text
  summary        String?  @db.Text
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("legal_documents")
}

model IntelligenceDocument {
  id                 String   @id @default(cuid())
  userId             String
  conversationId     String?
  fileName           String
  fileSize           Int
  mimeType           String
  kind               String
  extractedText      String   @db.Text
  extractedCharCount Int
  truncated          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@map("intelligence_documents")
}

model ProjectInquiry {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  company     String?
  idea        String
  projectType String
  budget      String?
  timeline    String?
  description String   @db.Text
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("project_inquiries")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean   @default(false)
  timezone    String    @default("UTC")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, archivedAt])
  @@map("calendar_events")
}

model BusinessContact {
  id        String         @id @default(cuid())
  userId    String
  name      String
  email     String?
  company   String?
  phone     String?
  notes     String?        @db.Text
  status    String         @default("lead")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks BusinessTask[]

  @@index([userId, status])
  @@map("business_contacts")
}

model BusinessTask {
  id        String    @id @default(cuid())
  userId    String
  contactId String?
  title     String
  notes     String?   @db.Text
  dueAt     DateTime?
  status    String    @default("open")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact BusinessContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([contactId])
  @@map("business_tasks")
}

model AutomationRule {
  id             String    @id @default(cuid())
  userId         String
  name           String
  enabled        Boolean   @default(true)
  triggerType    String
  intervalHours  Int?
  actionType     String
  actionPayload  Json
  lastRunAt      DateTime?
  lastStatus     String?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId, enabled])
  @@map("automation_rules")
}

model AutomationRun {
  id        String   @id @default(cuid())
  userId    String
  ruleId    String
  status    String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ruleId])
  @@map("automation_runs")
}

model CommerceProduct {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  priceCents  Int
  currency    String   @default("usd")
  sku         String?
  inventory   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders CommerceOrder[]

  @@index([userId, active])
  @@map("commerce_products")
}

model CommerceOrder {
  id                      String    @id @default(cuid())
  userId                  String
  productId               String
  quantity                Int       @default(1)
  customerName            String
  customerEmail           String
  status                  String    @default("pending")
  totalCents              Int
  currency                String    @default("usd")
  stripeCheckoutSessionId String?   @unique
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([productId])
  @@map("commerce_orders")
}

model AdsCampaign {
  id             String    @id @default(cuid())
  userId         String
  name           String
  objective      String
  budgetCents    Int
  headline       String
  body           String    @db.Text
  targetingNotes String?   @db.Text
  status         String    @default("draft")
  startsAt       DateTime?
  endsAt         DateTime?
  launchedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ads_campaigns")
}

model AppListing {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String   @db.Text
  platform    String
  url         String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, status])
  @@map("app_listings")
}

model Site {
  id          String    @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?   @db.Text
  status      String    @default("draft")
  pages       Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, status])
  @@map("sites")
}

model Flow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  status      String   @default("draft")
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("flows")
}

model BillingSubscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  stripeProductId      String?
  plan                 String    @default("pro")
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("billing_subscriptions")
}
