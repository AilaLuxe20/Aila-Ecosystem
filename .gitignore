# Aila — local and generated paths that must never be committed.

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests and coverage
/coverage/

# Next.js
/.next/
/out/

# Build output
/build/
/dist/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Certificates and private keys
*.pem
*.key

# Package manager / tool logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment and secrets (keep only .env.example tracked)
.env
.env.*
!.env.example

# Vercel CLI and local deploy diagnostics
.vercel/
.vercel-prod-*.log
.vercel-*.log

# Cloudflare Wrangler
.wrangler/
.dev.vars

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local route/audit scratch files
route-backup-*.zip
route-usage-audit.csv
routes-to-delete.csv
replacements.txt

# Backup and scaffold leftovers
*.bak
my-app/
build_output.txt
globals.txt

# Local diagnostic scripts and their output (never commit secrets)
scripts/_*.mjs
scripts/_*.out.json
scripts/_inspect-*.json
